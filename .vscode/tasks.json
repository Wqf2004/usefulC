{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-dfm-main",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\dfm\\build.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run-dfm-main",
            "type": "shell",
            "command": "${workspaceFolder}\\dfm\\build\\main.exe",
            "options": {
                "cwd": "${workspaceFolder}\\dfm"
            },
            "group": "test",
            "dependsOn": "build-dfm-main",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}